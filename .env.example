# ──────────────────────────────────────────────
# Brocooo Environment Variables
# Copy to .env.local (frontend) and .env (backend)
# ──────────────────────────────────────────────

# ── API / Backend ──
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./brocooo.db
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000

# ── LLM Providers (all optional — app works with any one) ──
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Media APIs (optional — enables B-roll and Explore) ──
PEXELS_API_KEY=
PIXABAY_API_KEY=
YOUTUBE_DATA_API_KEY=

# ── Transcription ──
WHISPER_MODEL=small
# Optional: Use Groq Whisper API as fast path
GROQ_WHISPER_ENABLED=false

# ── TTS ──
KOKORO_MODEL_PATH=./models/kokoro-82m
PIPER_MODEL_PATH=./models/piper

# ── Auth (optional) ──
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Storage (prod) ──
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=brocooo

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000
